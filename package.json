{
  "name": "studium",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.13.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "PORT=3000 next dev",
    "build": "next build",
    "start": "netlify dev",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "typecheck": "tsc --noEmit",
    "build:data:kjv": "ts-node --skipProject scripts/kjv-to-json.ts",
    "build:data:toc": "ts-node --skipProject scripts/kjv-to-table-of-contents.ts",
    "build:data:cross-references": "ts-node --skipProject scripts/cross-references-to-json.ts",
    "build:data:first-mention-index": "tsx scripts/build-first-mention-index.ts",
    "build:search-index": "ts-node --skipProject scripts/build-search-index.ts",
    "build:thompson-chain-references": "ts-node --skipProject scripts/build-thompson-chain-references.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@mdi/js": "^7.3.67",
    "@mdi/react": "^1.6.1",
    "framer-motion": "^10.16.14",
    "fuse.js": "^7.0.0",
    "fuzzysearch": "^1.0.3",
    "lodash": "^4.17.21",
    "next": "^16.1.1",
    "openai": "^4.20.0",
    "react": "^18",
    "react-dom": "^18",
    "react-error-boundary": "^4.0.11",
    "react-hotkeys-hook": "^5.0.1",
    "react-loading-skeleton": "^3.3.1",
    "s-ago": "^2.2.0",
    "slugify": "^1.6.6",
    "use-click-outside": "^2.0.0",
    "use-local-storage-state": "^19.1.0",
    "usehooks-ts": "^3.1.1",
    "uuid": "^9.0.1",
    "wink-porter2-stemmer": "^2.0.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/fuzzysearch": "^1.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.14.202",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^9.0.7",
    "eslint": "^8",
    "eslint-config-next": "16.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "jsdom": "^24.1.0",
    "knip": "^5.68.0",
    "minimist": "^1.2.8",
    "netlify-cli": "^17.8.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
