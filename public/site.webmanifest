{
  "id": "/",
  "name": "Studium",
  "short_name": "Studium",
  "description": "A focused, distraction-free reader for the Authorized King James Version with study tools and timelines.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
